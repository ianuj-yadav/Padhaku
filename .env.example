# Next.js server-side proxy to FastAPI
BACKEND_URL=http://127.0.0.1:8000

# FastAPI configuration
DATABASE_URL=sqlite+aiosqlite:///./padhaku.db
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Optional: AI-assisted synthesis of retrieved PDF passages.
# Without a key, Padhaku returns the matching source passages directly.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3
